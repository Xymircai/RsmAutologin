<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/branding/app-icon.ico</ApplicationIcon>
    <AssemblyName>EasLoginHelper</AssemblyName>
    <RootNamespace>EasLoginHelper</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.5.0</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Xymircai/RsmAutologin</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Product>审计软件自动登录助手</Product>
    <Description>EasyAudit、审计工具箱、新纪元与容诚网站登录助手</Description>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="[1.32.0]" />
    <EmbeddedResource Include="../../assets/branding/app-icon.ico" LogicalName="EasLoginHelper.Branding.Icon" />
    <EmbeddedResource Include="../../assets/models/common_old.onnx" LogicalName="EasLoginHelper.Ocr.Model" />
    <EmbeddedResource Include="../../assets/models/charset.json" LogicalName="EasLoginHelper.Ocr.Charset" />
    <EmbeddedResource Include="../../assets/models/manifest.json" LogicalName="EasLoginHelper.Ocr.Manifest" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="EasLoginHelper.Licenses.MPL-2.0.txt" />
    <EmbeddedResource Include="../../THIRD-PARTY-NOTICES.md" LogicalName="EasLoginHelper.Licenses.ThirdPartyNotices.txt" />
    <EmbeddedResource Include="../../assets/models/LICENSE-ddddocr.txt" LogicalName="EasLoginHelper.Licenses.ddddocr-MIT.txt" />
    <EmbeddedResource Include="../../README.md" LogicalName="EasLoginHelper.Help.txt" />
    <EmbeddedResource Include="$(NuGetPackageRoot)microsoft.ml.onnxruntime/1.32.0/LICENSE" LogicalName="EasLoginHelper.Licenses.ONNX-Runtime.txt" />
    <EmbeddedResource Include="$(NuGetPackageRoot)microsoft.ml.onnxruntime/1.32.0/ThirdPartyNotices.txt" LogicalName="EasLoginHelper.Licenses.ONNX-ThirdPartyNotices.txt" />
    <EmbeddedResource Include="$([System.IO.Path]::GetFullPath('$(MSBuildSDKsPath)/../../../LICENSE.txt'))" LogicalName="EasLoginHelper.Licenses.DotNet.txt" />
    <EmbeddedResource Include="$([System.IO.Path]::GetFullPath('$(MSBuildSDKsPath)/../../../ThirdPartyNotices.txt'))" LogicalName="EasLoginHelper.Licenses.DotNet-ThirdPartyNotices.txt" />
  </ItemGroup>
</Project>
