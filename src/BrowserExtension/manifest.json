{
  "manifest_version": 3,
  "name": "容诚网站登录助手",
  "version": "0.5.0",
  "description": "为从审计软件自动登录助手打开的容诚登录页填写默认账号。",
  "key": "",
  "minimum_chrome_version": "102",
  "permissions": ["nativeMessaging", "storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": [
      "https://mail.rccpa.com.cn/*",
      "https://www.rccpa.com.cn/*",
      "https://sso.rccpa.com.cn/*",
      "https://download.rsmchina.com.cn/*"
    ],
    "js": ["sites.js", "login-form.js", "content.js"],
    "run_at": "document_start",
    "all_frames": false
  }]
}
